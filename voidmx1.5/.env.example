# Variables de entorno para voidmx1.5

# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=tu_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key
SUPABASE_SERVICE_KEY=tu_supabase_service_key

# ===========================================
# BACKEND API CONFIGURATION
# ===========================================
PORT=4000
API_BASE_URL=http://localhost:4000

# ===========================================
# COMFYUI CONFIGURATION (REMOTO)
# ===========================================
# URL de tu instancia de ComfyUI desplegada en la red
COMFYUI_URL=http://tu-comfyui-remoto:8188

# Si ComfyUI tiene autenticación, agrega aquí el token
# COMFYUI_API_KEY=tu_api_key_opcional

# ===========================================
# STORAGE CONFIGURATION
# ===========================================
# Directorio temporal para archivos subidos
UPLOAD_DIR=./uploads

# URL base para videos generados (puede ser un CDN o bucket S3)
VIDEO_STORAGE_URL=http://localhost:4000/videos
